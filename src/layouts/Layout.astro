---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AHH Construcción y Remodelación — Construcción, remodelación y desarrollo inmobiliario en Chihuahua.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#182028" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AHH Construcción y Remodelación" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/icon-512.png" />
    <meta name="twitter:card" content="summary" />
    <!-- Marca que hay JS antes de pintar: las animaciones de entrada parten de
         opacity:0, así que sin esta clase el contenido queda invisible si el
         script no corre. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="antialiased overflow-x-hidden">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <script>
      function initPage() {
        // Mobile menu overlay
        const menuBtn = document.getElementById('mobile-menu-btn');
        const overlay = document.getElementById('mobile-menu');
        const closeBtn = document.getElementById('mobile-menu-close');
        if (menuBtn && overlay && !menuBtn.dataset.bound) {
          menuBtn.dataset.bound = 'true';
          const setOpen = (open: boolean) => {
            overlay.classList.toggle('open', open);
            overlay.setAttribute('aria-hidden', String(!open));
            menuBtn.setAttribute('aria-expanded', String(open));
            document.body.style.overflow = open ? 'hidden' : '';
          };
          menuBtn.addEventListener('click', () => setOpen(true));
          closeBtn?.addEventListener('click', () => setOpen(false));
          overlay.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
          document.addEventListener('keydown', e => {
            if (e.key === 'Escape') setOpen(false);
          });
        }

        // Scroll reveal (all variants)
        const reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-blur');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(el => observer.observe(el));

        // Count-up numbers: "+10" ticks from 0 once it enters the viewport
        const counters = document.querySelectorAll<HTMLElement>('[data-count]');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const countObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            countObserver.unobserve(el);
            const raw = el.dataset.count || '';
            const target = parseInt(raw.replace(/\D/g, ''), 10) || 0;
            const prefix = raw.startsWith('+') ? '+' : '';
            if (reduced) { el.textContent = raw; return; }
            const duration = 1400;
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = prefix + Math.round(target * eased);
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.4 });
        counters.forEach(el => { el.textContent = el.dataset.count?.startsWith('+') ? '+0' : '0'; countObserver.observe(el); });

        // Project filter tabs
        const tabs = document.querySelectorAll<HTMLElement>('[data-filter]');
        const items = document.querySelectorAll<HTMLElement>('[data-category]');
        tabs.forEach(tab => {
          if (tab.dataset.bound) return;
          tab.dataset.bound = 'true';
          tab.addEventListener('click', () => {
            const filter = tab.dataset.filter;
            tabs.forEach(t => t.classList.remove('tab-active'));
            tab.classList.add('tab-active');
            items.forEach(item => {
              const match = filter === 'todos' || item.dataset.category === filter;
              item.classList.toggle('hidden', !match);
              if (match) {
                item.classList.remove('fade-in');
                void item.offsetWidth;
                item.classList.add('fade-in');
              }
            });
          });
        });
      }

      function initHeader() {
        const header = document.getElementById('main-header');
        if (!header || header.dataset.bound) return;
        header.dataset.bound = 'true';

        setTimeout(() => header.classList.add('nav-in'), 200);

        // La barra es transparente, así que el color lo dicta la sección que
        // queda debajo. El hero de video actualiza su propio data-nav-theme
        // mientras avanza, así que aquí no necesita caso especial.
        const probe = () => {
          const y = header.getBoundingClientRect().bottom - 10;
          // Sin coincidencia asumimos claro: el fondo del body es bone, así que
          // el texto blanco sería el que desaparece.
          const hit = document
            .elementsFromPoint(window.innerWidth / 2, y)
            .find(n => n instanceof HTMLElement && n.dataset.navTheme) as HTMLElement | undefined;
          header.classList.toggle('nav-on-light', hit?.dataset.navTheme !== 'dark');
        };
        window.addEventListener('scroll', probe, { passive: true });
        window.addEventListener('resize', probe);
        probe();
      }

      // astro:page-load fires on the first load too, so binding here covers both cases
      document.addEventListener('astro:page-load', () => { initPage(); initHeader(); });
    </script>
  </body>
</html>
