---
interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md';
  href?: string;
}
const { variant = 'light', size = 'md', href = '/' } = Astro.props;

const src = variant === 'light'
  ? '/logo/logo-horizontal-negativo.png'
  : '/logo/logo-horizontal.png';
const height = size === 'sm' ? 'h-10' : 'h-12';
---

<a href={href} class="inline-flex items-center group" aria-label="AHH Construcción y Remodelación">
  <img
    src={src}
    alt="AHH Construcción y Remodelación"
    width="560"
    height="165"
    loading="eager"
    decoding="async"
    class={`${height} w-auto transition-opacity duration-300 group-hover:opacity-80`}
  />
</a>
