---
import Logo from './Logo.astro';
import { contact, services, brand } from '../data/site';

interface Props {
  variant?: 'full' | 'compact';
  legal?: boolean;
}
const { variant = 'compact', legal = false } = Astro.props;
const currentYear = new Date().getFullYear();

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Servicios', href: '/servicios' },
  { name: 'Propiedades', href: '/propiedades' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Contacto', href: '/contacto' },
];
---

<footer data-nav-theme="dark" class="bg-dark text-gray-400">
  {variant === 'full' && (
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">

        <!-- Brand -->
        <div>
          <Logo variant="light" />
          <p class="text-sm text-gray-500 leading-relaxed mt-6 max-w-xs">
            {brand.slogan} {brand.yearsOfExperience} años construyendo y remodelando
            en {contact.coverage}.
          </p>
        </div>

        <!-- Quick links -->
        <div>
          <h4 class="eyebrow mb-6">Enlaces rápidos</h4>
          <ul class="space-y-3.5">
            {navLinks.map(link => (
              <li><a href={link.href} class="text-sm hover:text-sand transition-colors">{link.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Services -->
        <div>
          <h4 class="eyebrow mb-6">Servicios</h4>
          <ul class="space-y-3.5">
            {services.map(s => (
              <li><a href="/servicios" class="text-sm hover:text-sand transition-colors">{s.title}</a></li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="eyebrow mb-6">Contacto</h4>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand mt-0.5 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{contact.street}, {contact.colonia}<br />{contact.city}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand mt-0.5 shrink-0"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {contact.hours}
            </li>
            {contact.hasPhone && (
              <li class="flex items-center gap-3">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand shrink-0"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                <a href={contact.phoneHref} class="hover:text-sand transition-colors">{contact.phone}</a>
              </li>
            )}
            <li>
              <a href="/contacto" class="link-accent !text-sand">Envíanos un mensaje</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  )}

  {variant === 'compact' && (
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10 py-7">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="flex flex-col sm:flex-row items-center gap-6 lg:gap-8 text-center sm:text-left">
          <Logo variant="light" size="sm" />
          <span class="hidden sm:block w-px h-10 bg-white/10"></span>
          <div class="flex flex-col sm:flex-row items-center gap-5 sm:gap-8 text-sm">
            <span class="flex items-center gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {contact.street}, {contact.colonia}
            </span>
            <span class="flex items-center gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand shrink-0"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {contact.hours}
            </span>
            {contact.hasPhone && (
              <a href={contact.phoneHref} class="flex items-center gap-2.5 hover:text-sand transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-sand shrink-0"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                {contact.phone}
              </a>
            )}
          </div>
        </div>

        <a href="/contacto" class="pill-solid shrink-0">
          Cotiza tu proyecto
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  )}

  {(legal || variant === 'full') && (
    <div class="border-t border-white/8">
      <div class="max-w-[88rem] mx-auto px-6 lg:px-10 py-5 text-center text-xs text-gray-600">
        <p>&copy; {currentYear} {brand.name}. Todos los derechos reservados.</p>
      </div>
    </div>
  )}
</footer>
