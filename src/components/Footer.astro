  {(legal || variant === 'full') && (
    <div class="border-t border-white/8">
      <div class="max-w-[88rem] mx-auto px-6 lg:px-10 py-5 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-10 text-xs text-gray-600">
        <p>&copy; {currentYear} AHH Construcción y Remodelación. Todos los derechos reservados.</p>
        <div class="flex gap-8">
          <a href="#" class="hover:text-gray-400 transition-colors">Aviso de privacidad</a>
          <a href="#" class="hover:text-gray-400 transition-colors">Términos y condiciones</a>
        </div>
      </div>
    </div>
