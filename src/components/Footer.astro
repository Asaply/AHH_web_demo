---
const currentYear = new Date().getFullYear();
---

<!-- CTA Banner -->
<section class="relative bg-navy-dark">
  <div class="absolute inset-0 bg-gradient-to-r from-navy-dark/90 to-navy-dark/70" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&q=60'); background-size: cover; background-position: center;">
    <div class="absolute inset-0 bg-navy-dark/80"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 border-2 border-gold rounded-lg flex items-center justify-center text-gold">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-white">VAMOS A CONSTRUIR ALGO GRANDE</h3>
          <p class="text-gray-400 text-sm">Juntos podemos hacer realidad el proyecto que tienes en mente.</p>
        </div>
      </div>
      <a href="/contacto" class="btn-outline-white text-xs tracking-widest whitespace-nowrap">
        COTIZA TU PROYECTO
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-navy-dark text-gray-400 border-t border-gray-800">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <div class="text-white">
          <div class="text-2xl font-bold tracking-wider" style="font-family: var(--font-heading);">
            <span class="text-gold">A</span>H<span class="text-gold">H</span>
          </div>
          <div class="text-[7px] tracking-[0.15em] text-gray-400 uppercase -mt-1">Construcción y Remodelación</div>
        </div>
      </div>

      <!-- Info items -->
      <div class="flex flex-col sm:flex-row items-center gap-6 text-sm">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Chihuahua, Chihuahua, México
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          (614) 123 4567
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          contacto@ahhconstruccion.mx
        </div>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-3">
        <span class="text-sm text-gray-500 mr-2">SÍGUENOS</span>
        <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:border-gold hover:text-gold transition-colors" aria-label="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:border-gold hover:text-gold transition-colors" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:border-gold hover:text-gold transition-colors" aria-label="LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
        </a>
        <a href="https://wa.me/526141234567" target="_blank" rel="noopener" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:border-gold hover:text-gold transition-colors" aria-label="WhatsApp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500">
        <p>&copy; {currentYear} AHH Construcción y Remodelación. Todos los derechos reservados.</p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-gray-300 transition-colors">Aviso de privacidad</a>
          <a href="#" class="hover:text-gray-300 transition-colors">Términos y condiciones</a>
        </div>
      </div>
    </div>
  </div>
</footer>
