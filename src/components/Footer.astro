          </div>
        </div>

        <div class="flex items-center gap-4">
          <span class="eyebrow hidden sm:inline">Síguenos</span>
          <div class="flex items-center gap-3">
            {socials.map(s => (
              <a href={s.href} class="w-9 h-9 rounded-full bg-white/6 flex items-center justify-center text-gray-300 hover:bg-gold hover:text-white transition-all duration-300" aria-label={s.name}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={s.path}/></svg>
              </a>
            ))}
            <a href="#" class="w-9 h-9 rounded-full bg-white/6 flex items-center justify-center text-gray-300 hover:bg-gold hover:text-white transition-all duration-300" aria-label="Instagram">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
