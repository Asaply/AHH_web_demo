---
import Logo from './Logo.astro';

interface Props {
  variant?: 'full' | 'compact';
  legal?: boolean;
}
const { variant = 'compact', legal = false } = Astro.props;
const currentYear = new Date().getFullYear();

const socials = [
  { name: 'Facebook', href: '#', path: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z', fill: true },
  { name: 'LinkedIn', href: '#', path: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z', fill: true },
];
---

<footer class="bg-dark text-gray-400">
  {variant === 'full' && (
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">

        <!-- Brand -->
        <div>
          <Logo variant="light" />
          <p class="text-sm text-gray-500 leading-relaxed mt-6 mb-7 max-w-xs">
            Construimos confianza, creamos valor. Proyectos que mejoran tu vida y hacen crecer tu patrimonio.
          </p>
          <div class="flex gap-3">
            <a href="#" class="w-9 h-9 rounded-full bg-white/6 flex items-center justify-center text-gray-400 hover:bg-gold hover:text-white transition-all duration-300" aria-label="Facebook">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded-full bg-white/6 flex items-center justify-center text-gray-400 hover:bg-gold hover:text-white transition-all duration-300" aria-label="Instagram">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://wa.me/526141234567" target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-white/6 flex items-center justify-center text-gray-400 hover:bg-gold hover:text-white transition-all duration-300" aria-label="WhatsApp">
