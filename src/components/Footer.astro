            </a>
          </div>
        </div>

        <!-- Quick links -->
        <div>
          <h4 class="eyebrow mb-6">Enlaces rápidos</h4>
          <ul class="space-y-3.5">
            <li><a href="/" class="text-sm hover:text-gold transition-colors">Inicio</a></li>
            <li><a href="/servicios" class="text-sm hover:text-gold transition-colors">Servicios</a></li>
            <li><a href="/propiedades" class="text-sm hover:text-gold transition-colors">Propiedades</a></li>
            <li><a href="/proyectos" class="text-sm hover:text-gold transition-colors">Proyectos</a></li>
            <li><a href="/nosotros" class="text-sm hover:text-gold transition-colors">Nosotros</a></li>
            <li><a href="/contacto" class="text-sm hover:text-gold transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Services -->
        <div>
          <h4 class="eyebrow mb-6">Servicios</h4>
          <ul class="space-y-3.5">
            <li><a href="/servicios" class="text-sm hover:text-gold transition-colors">Construcción</a></li>
            <li><a href="/servicios" class="text-sm hover:text-gold transition-colors">Remodelación</a></li>
            <li><a href="/servicios" class="text-sm hover:text-gold transition-colors">Desarrollo Inmobiliario</a></li>
            <li><a href="/servicios" class="text-sm hover:text-gold transition-colors">Diseño y Planificación</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="eyebrow mb-6">Contacto</h4>
          <ul class="space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold mt-0.5 shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Chihuahua, Chihuahua, México
            </li>
            <li class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold shrink-0"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              <a href="tel:+526141234567" class="hover:text-gold transition-colors">(614) 123 4567</a>
            </li>
            <li class="flex items-center gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
