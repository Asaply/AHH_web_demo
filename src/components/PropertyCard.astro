---
import Icon from './Icon.astro';
import type { Property } from '../data/site';

interface Props {
  property: Property;
  variant?: 'compact' | 'full';
  delay?: string;
}
const { property: p, variant = 'compact', delay = '' } = Astro.props;
---

<article class={`card reveal ${delay} flex flex-col`}>
  <div class="media h-56 sm:h-60" style={`background-image:url('${p.image}')`}>
    <span class="tag">En venta</span>
  </div>

  <div class="p-6 flex flex-col flex-1">
    <h3 class={variant === 'full' ? 'display display-sm mb-2' : 'text-lg font-semibold mb-2'}>{p.name}</h3>

    <p class="flex items-center gap-2 text-sm text-gray-500 mb-5">
      <Icon name="pin" size={16} class="text-gold shrink-0" />
      {p.location}
    </p>

    <div class="flex items-center gap-4 sm:gap-5 text-sm text-gray-600 py-4 border-y border-black/6">
      <span class="flex items-center gap-1.5"><Icon name="bed" size={17} class="text-gray-400" />{p.beds}</span>
      <span class="flex items-center gap-1.5"><Icon name="bath" size={17} class="text-gray-400" />{p.baths}</span>
      <span class="flex items-center gap-1.5"><Icon name="area" size={17} class="text-gray-400" />{p.area} m²</span>
      <span class="flex items-center gap-1.5"><Icon name="car" size={17} class="text-gray-400" />{p.parking}</span>
    </div>

    <div class={`mt-5 flex items-end justify-between gap-4 ${variant === 'compact' ? '' : 'flex-wrap'}`}>
      <div>
        {variant === 'full' && <p class="text-xs text-gray-500 mb-1">Precio:</p>}
        <p class="display display-sm text-gold">{p.price}</p>
      </div>
      {variant === 'full' && (
        <a href="/contacto" class="btn-outline !py-2.5 !px-5 !text-[11px]">
          Ver detalles
          <Icon name="arrow" size={14} stroke={2} />
        </a>
      )}
    </div>
  </div>
</article>
