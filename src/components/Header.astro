---
import Icon from './Icon.astro';
import { contact } from '../data/site';

interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Servicios', href: '/servicios' },
  { name: 'Propiedades', href: '/propiedades' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Contacto', href: '/contacto' },
];
---

<header
  id="main-header"
  class="fixed top-3 sm:top-5 left-0 right-0 z-50 px-4 sm:px-6 md:px-8"
>
  <div class="nav-pill max-w-[88rem] mx-auto flex items-center justify-between gap-6 pl-5 pr-4 sm:pl-6 sm:pr-5 py-3">
    <div class="flex items-center gap-8 xl:gap-10 min-w-0">
      <a href="/" class="nav-logo shrink-0" aria-label="AHH Construcción y Remodelación">
        <img src="/logo/logo-horizontal-negativo.png" alt="" width="560" height="165" />
      </a>

      <nav class="hidden lg:flex items-center gap-8 xl:gap-10">
        {navLinks.map((link, i) => (
          <div class="nav-item" style={`--d:${i * 80 + 100}ms`}>
            <a href={link.href} class={`nav-link ${activePage === link.name ? 'nav-link-active' : ''}`}>
              {link.name}
              {activePage === link.name && <span class="nav-underline"></span>}
            </a>
          </div>
        ))}
      </nav>
    </div>

    <div class="nav-item flex items-center gap-5 md:gap-8 shrink-0" style="--d:500ms">
      <a href="/contacto" class="hidden sm:flex items-center gap-2 group">
        <span class="nav-label">Cotizar</span>
        <span class="nav-dot">
          <Icon name="arrow" size={10} stroke={2.4} />
        </span>
      </a>

      <span class="nav-label hidden lg:inline">Menú</span>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="lg:hidden flex flex-col"
        style="gap:5px"
      >
        <span class="nav-bar-line" style="width:24px"></span>
        <span class="nav-bar-line" style="width:24px"></span>
        <span class="nav-bar-line" style="width:16px"></span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay -->
<div id="mobile-menu" class="nav-overlay" aria-hidden="true">
  <div class="nav-overlay-panel h-full flex flex-col">
    <div class="flex justify-end px-6 sm:px-8 pt-8 sm:pt-12">
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Cerrar menú"
        class="flex items-center justify-center rounded-full border border-white/30 hover:border-white transition-colors duration-300"
        style="width:40px;height:40px"
      >
        <Icon name="close" size={18} stroke={2} class="text-white" />
      </button>
    </div>

    <nav class="flex-1 flex flex-col justify-center">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class={`nav-overlay-link px-8 sm:px-12 py-3 text-2xl sm:text-3xl font-light tracking-wide uppercase ${
            activePage === link.name ? 'text-white' : 'text-white/60 hover:text-white'
          }`}
          style={`--d:${i * 60}ms`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <div class="px-8 sm:px-12 pb-10 flex items-center gap-8 text-xs tracking-[0.2em] uppercase text-white/60">
      <span>{contact.hours}</span>
      <a href="/contacto" class="hover:text-white transition-colors">Cotizar</a>
    </div>
  </div>
</div>

<style>
  /* Liquid glass: un film sobre desenfoque pesado, así la barra toma su tinte
     de lo que pasa por debajo en vez de pintar un color propio. */
  #main-header {
    color: #fff;
  }

  .nav-pill {
    position: relative;
    border-radius: 980px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(22px) saturate(200%);
    -webkit-backdrop-filter: blur(22px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.28);
    transition:
      background 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  /* Reflejo especular sobre la curva superior. */
  .nav-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.04) 42%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* Sobre secciones claras el film se invierte a oscuro: las etiquetas siguen
     en blanco, así que el contraste lo pone el cristal y no el texto. */
  #main-header.nav-on-light .nav-pill {
    background: rgba(10, 14, 23, 0.82);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 44px rgba(0, 0, 0, 0.34);
  }

  .nav-logo {
    display: block;
  }
  .nav-logo img {
    height: 34px;
    width: auto;
  }

  .nav-link {
    position: relative;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
    color: currentColor;
    transition: opacity 0.25s ease;
  }
  .nav-link:hover {
    opacity: 0.7;
  }
  .nav-underline {
    position: absolute;
    left: 0;
    bottom: -0.75rem;
    width: 100%;
    height: 2px;
    background: currentColor;
  }

  .nav-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: currentColor;
    transition: opacity 0.25s ease;
  }
  .group:hover .nav-label {
    opacity: 0.7;
  }

  /* Nada de currentColor aquí: al fijar `color` en el mismo elemento, el
     background se resolvería contra él y el círculo desaparecería. */
  .nav-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: #fff;
    color: var(--color-dark);
    transition:
      background 0.5s ease,
      color 0.5s ease;
  }
  .nav-bar-line {
    display: block;
    height: 2px;
    background: currentColor;
    transition: background 0.5s ease;
  }

  /* Entrada escalonada */
  .nav-item {
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms);
  }
  #main-header.nav-in .nav-item {
    opacity: 1;
    transform: none;
  }

  /* Overlay */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-dark);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .nav-overlay-panel {
    transform: translateY(-2rem);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-overlay.open .nav-overlay-panel {
    transform: none;
  }
  .nav-overlay-link {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) var(--d, 0ms),
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) var(--d, 0ms),
      color 0.3s ease;
  }
  .nav-overlay.open .nav-overlay-link {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-item,
    .nav-overlay-link {
      transition-duration: 0.001ms !important;
    }
  }
</style>
