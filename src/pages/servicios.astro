---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { services, features } from '../data/site';

const delays = ['', 'reveal-delay-1', 'reveal-delay-2', 'reveal-delay-3'];
---

<Layout title="Servicios — AHH Construcción">
  <Header slot="header" activePage="Servicios" />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-media" style="background-image:url('/img/hero-servicios.jpg')"></div>
    <div class="relative max-w-[88rem] mx-auto px-6 lg:px-10 py-20 lg:py-24">
      <nav class="reveal flex items-center gap-2 text-xs tracking-[0.16em] uppercase mb-6">
        <a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a>
        <span class="text-white/30">/</span>
        <span class="text-gold">Servicios</span>
      </nav>

      <h1 class="reveal reveal-delay-1 display display-lg text-white mb-6">Nuestros servicios</h1>
      <div class="reveal reveal-delay-1 gold-line mb-8"></div>

      <p class="reveal reveal-delay-2 text-gray-300 text-base lg:text-lg leading-relaxed max-w-md">
        Soluciones integrales de construcción y desarrollo con calidad, diseño y funcionalidad.
      </p>
    </div>
  </section>

  <!-- Service cards -->
  <section class="bg-surface py-16 lg:py-20">
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-7">
        {services.map((s, i) => (
          <article class={`card reveal-scale ${delays[i]} flex flex-col`}>
            <div class="media h-52" style={`background-image:url('${s.image}')`}></div>

            <div class="p-7 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-4">
                <Icon name={s.icon} size={30} class="text-gold shrink-0" stroke={1.2} />
                <span class="display text-xl text-gold">{s.num}</span>
              </div>

              <h3 class="display display-sm mb-4">{s.title}</h3>

              <p class="text-sm text-gray-600 leading-relaxed mb-6">{s.summary}</p>

              <ul class="check-list space-y-3 mb-8">
                {s.points.map(point => (
                  <li>
                    <Icon name="check" size={15} class="text-gold shrink-0 mt-0.5" stroke={2.2} />
                    {point}
                  </li>
                ))}
              </ul>

              <a href="/contacto" class="link-gold mt-auto">
                Conoce más
                <Icon name="arrow" size={15} stroke={2} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="hero">
    <div class="hero-media dim" style="background-image:url('/img/cta-band.jpg')"></div>
    <div class="relative max-w-[88rem] mx-auto px-6 lg:px-10 py-14 lg:py-16">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-12">

        <div class="lg:w-1/4 text-center lg:text-left">
          <h2 class="display display-md text-white mb-3">¿Tienes un proyecto<br class="hidden lg:block"> en mente?</h2>
          <p class="text-gold text-sm">Estamos listos para hacerlo realidad.</p>
        </div>

        <div class="hidden lg:block w-px self-stretch bg-white/15"></div>

        <div class="lg:flex-1 grid grid-cols-2 lg:grid-cols-4 gap-8">
          {features.map(f => (
            <div class="text-center">
              <Icon name={f.icon} size={30} class="text-gold mx-auto mb-4" stroke={1.2} />
              <p class="display text-[11px] text-white tracking-[0.1em] leading-snug">{f.title}</p>
            </div>
          ))}
        </div>

        <a href="/contacto" class="btn-primary shrink-0">
          Cotiza tu proyecto
          <Icon name="arrow" size={16} stroke={2} />
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" variant="compact" />
</Layout>
