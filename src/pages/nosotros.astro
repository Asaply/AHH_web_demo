---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Nosotros - AHH Construcción y Remodelación" activePage="NOSOTROS">
  <Header slot="header" activePage="NOSOTROS" />

  <!-- Hero Section -->
  <section class="bg-navy-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left content -->
        <div>
          <nav class="flex items-center gap-2 text-sm text-gold mb-8">
            <a href="/" class="hover:underline">Inicio</a>
            <span>&gt;</span>
            <span>Nosotros</span>
          </nav>

          <h1 class="text-4xl lg:text-5xl font-bold text-white tracking-wide mb-4" style="font-family: var(--font-heading);">
            SOBRE AHH
          </h1>
          <div class="gold-line mb-8"></div>

          <p class="text-lg lg:text-xl font-bold text-white mb-4">
            En AHH Construcción y Remodelación transformamos ideas en proyectos reales.
          </p>
          <p class="text-gray-400 leading-relaxed mb-8">
            Somos una empresa chihuahuense especializada en construcción, remodelación y desarrollo inmobiliario, comprometida con la calidad, el diseño y la funcionalidad en cada detalle.
          </p>

          <a href="/proyectos" class="btn-gold text-xs tracking-widest">
            CONOCE NUESTROS PROYECTOS
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Right placeholder -->
        <div class="bg-gray-600 rounded h-80 lg:h-[28rem]"></div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="text-center mb-14">
        <span class="text-sm tracking-widest text-gold font-semibold">NUESTROS</span>
        <h2 class="text-3xl lg:text-4xl font-bold mt-2" style="font-family: var(--font-heading);">VALORES</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <!-- Calidad -->
        <div class="bg-white rounded-lg p-6 text-center card-hover">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm tracking-wider mb-2">CALIDAD</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Utilizamos materiales y procesos de la más alta calidad.</p>
        </div>

        <!-- Compromiso -->
        <div class="bg-white rounded-lg p-6 text-center card-hover">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm tracking-wider mb-2">COMPROMISO</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Cumplimos lo que prometemos, en tiempo y forma.</p>
        </div>

        <!-- Innovación -->
        <div class="bg-white rounded-lg p-6 text-center card-hover">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm tracking-wider mb-2">INNOVACIÓN</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Diseñamos soluciones modernas y funcionales para cada proyecto.</p>
        </div>

        <!-- Confianza -->
        <div class="bg-white rounded-lg p-6 text-center card-hover">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm tracking-wider mb-2">CONFIANZA</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Construimos relaciones de largo plazo basadas en transparencia.</p>
        </div>

        <!-- Sustentabilidad -->
        <div class="bg-white rounded-lg p-6 text-center card-hover">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm tracking-wider mb-2">SUSTENTABILIDAD</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Creamos proyectos responsables con el entorno y el futuro.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left content -->
        <div>
          <span class="text-sm tracking-widest text-gold font-semibold">EL EQUIPO AHH</span>
          <h2 class="text-3xl lg:text-4xl font-bold mt-3 mb-6" style="font-family: var(--font-heading);">
            Detrás de cada proyecto, hay un gran equipo.
          </h2>
          <p class="text-gray-500 leading-relaxed mb-8">
            Contamos con arquitectos, ingenieros y especialistas apasionados por construir espacios que mejoran la vida de las personas.
          </p>
          <a href="/contacto" class="btn-outline text-xs tracking-widest">
            TRABAJA CON NOSOTROS
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Right placeholder -->
        <div class="h-96 bg-gray-400 rounded"></div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-navy-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
        <!-- Proyectos -->
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-gold mb-1" style="font-family: var(--font-heading);">+150</div>
          <p class="text-gray-400 text-sm tracking-wider font-semibold">PROYECTOS REALIZADOS</p>
        </div>

        <!-- Años -->
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-gold mb-1" style="font-family: var(--font-heading);">+10</div>
          <p class="text-gray-400 text-sm tracking-wider font-semibold">AÑOS DE EXPERIENCIA</p>
        </div>

        <!-- Clientes -->
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-gold mb-1" style="font-family: var(--font-heading);">+100</div>
          <p class="text-gray-400 text-sm tracking-wider font-semibold">CLIENTES SATISFECHOS</p>
        </div>

        <!-- Especialistas -->
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 border-2 border-gold rounded-full flex items-center justify-center text-gold">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-gold mb-1" style="font-family: var(--font-heading);">+30</div>
          <p class="text-gray-400 text-sm tracking-wider font-semibold">ESPECIALISTAS EN EL EQUIPO</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
