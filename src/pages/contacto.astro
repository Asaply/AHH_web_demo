---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';

const infoBlocks = [
  { icon: 'phone', title: 'Teléfono', value: contact.phone, href: contact.phoneHref, note: contact.hours },
  { icon: 'mail', title: 'Correo', value: contact.email, href: `mailto:${contact.email}`, note: 'Responderemos a la brevedad' },
  { icon: 'pin', title: 'Dirección', value: contact.city, href: '', note: contact.zip },
];
---

<Layout title="Contacto — AHH Construcción">
  <Header slot="header" activePage="Contacto" />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-media" style="background-image:url('/img/hero-contacto.jpg')"></div>
    <div class="relative max-w-[88rem] mx-auto px-6 lg:px-10 py-20 lg:py-24">
      <nav class="reveal flex items-center gap-2 text-sm mb-5">
        <a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a>
        <span class="text-white/30">&rsaquo;</span>
        <span class="text-gold">Contacto</span>
      </nav>

      <h1 class="reveal reveal-delay-1 display display-lg text-white mb-6">
        Estamos listos<br>para construir <span class="text-gold">tu proyecto.</span>
      </h1>
      <div class="reveal reveal-delay-1 gold-line mb-8"></div>

      <p class="reveal reveal-delay-2 text-gray-300 text-base lg:text-lg leading-relaxed max-w-md">
        Hablemos de tus ideas y encontremos la mejor solución para hacerlas realidad.
      </p>
    </div>
  </section>

  <!-- Form + info + map -->
  <section class="bg-surface py-16 lg:py-20">
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Form -->
        <div class="reveal lg:col-span-5 bg-white border border-black/8 rounded-sm p-8 lg:p-9">
          <div class="flex items-center gap-3 mb-3">
            <Icon name="mail" size={26} class="text-gold shrink-0" stroke={1.3} />
            <h2 class="display display-sm">Envíanos un mensaje</h2>
          </div>
          <div class="gold-line-sm mb-8"></div>

          <form class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input type="text" name="nombre" required placeholder="Nombre completo*" class="field" aria-label="Nombre completo" />
              <input type="tel" name="telefono" required placeholder="Teléfono*" class="field" aria-label="Teléfono" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <input type="email" name="correo" required placeholder="Correo electrónico*" class="field" aria-label="Correo electrónico" />
              <select name="tipo" class="field text-gray-500" aria-label="Tipo de proyecto">
                <option value="">Tipo de proyecto</option>
                <option value="construccion">Construcción</option>
                <option value="remodelacion">Remodelación</option>
                <option value="desarrollo">Desarrollo inmobiliario</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <textarea name="mensaje" rows="6" required placeholder="Cuéntanos sobre tu proyecto*" class="field resize-none" aria-label="Mensaje"></textarea>

            <button type="submit" class="btn-primary">
              Enviar mensaje
              <Icon name="arrow" size={16} stroke={2} />
            </button>

            <p class="flex items-center gap-2 text-xs text-gray-500 pt-1">
              <Icon name="shield" size={15} class="text-gold shrink-0" />
              Tu información está protegida. No compartimos tus datos.
            </p>
          </form>
        </div>

        <!-- Contact info -->
        <div class="reveal reveal-delay-1 lg:col-span-3 bg-white border border-black/8 rounded-sm p-6">
          <div class="divide-y divide-black/8">
            {infoBlocks.map(b => (
              <div class="flex items-start gap-3.5 py-5 first:pt-0 last:pb-0">
                <span class="w-10 h-10 rounded-full bg-dark flex items-center justify-center shrink-0">
                  <Icon name={b.icon} size={18} class="text-gold" stroke={1.5} />
                </span>
                <div class="min-w-0">
                  <h3 class="display text-[11px] tracking-[0.14em] mb-1.5">{b.title}</h3>
                  {b.href
                    ? <a href={b.href} class="block text-[13px] text-gray-800 hover:text-gold transition-colors">{b.value}</a>
                    : <p class="text-[13px] text-gray-800">{b.value}</p>}
                  <p class="text-[11px] text-gray-500 mt-1">{b.note}</p>
                </div>
              </div>
            ))}

            <div class="flex items-start gap-3.5 py-5 last:pb-0">
              <span class="w-10 h-10 rounded-full bg-dark flex items-center justify-center shrink-0">
                <Icon name="share" size={18} class="text-gold" stroke={1.5} />
              </span>
              <div>
                <h3 class="display text-[11px] tracking-[0.14em] mb-3">Síguenos</h3>
                <div class="flex items-center gap-2.5">
                  <a href="#" class="w-9 h-9 rounded-full bg-dark flex items-center justify-center text-gold hover:bg-gold hover:text-white transition-all duration-300" aria-label="Facebook">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                  </a>
                  <a href="#" class="w-9 h-9 rounded-full bg-dark flex items-center justify-center text-gold hover:bg-gold hover:text-white transition-all duration-300" aria-label="Instagram">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  </a>
                  <a href="#" class="w-9 h-9 rounded-full bg-dark flex items-center justify-center text-gold hover:bg-gold hover:text-white transition-all duration-300" aria-label="LinkedIn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Map + meeting CTA -->
        <div class="reveal-right reveal-delay-2 lg:col-span-4 flex flex-col gap-6">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <Icon name="pin" size={24} class="text-gold shrink-0" stroke={1.3} />
              <h2 class="display display-sm">Nuestra ubicación</h2>
            </div>
            <div class="gold-line-sm mb-6"></div>
            <div class="rounded-sm border border-black/8 overflow-hidden">
              <iframe
                title="Ubicación de AHH Construcción en Chihuahua"
                src="https://www.openstreetmap.org/export/embed.html?bbox=-106.11%2C28.62%2C-106.03%2C28.68&layer=mapnik&marker=28.6353%2C-106.0889"
                width="100%"
                height="288"
                loading="lazy"
                style="border:0;display:block"
              ></iframe>
            </div>
          </div>

          <div class="bg-dark noise p-7">
            <div class="relative flex items-start gap-4 mb-5">
              <Icon name="calendar" size={28} class="text-gold shrink-0 mt-0.5" stroke={1.3} />
              <div>
                <h3 class="display text-[13px] tracking-[0.1em] text-white mb-1.5">¿Prefieres una reunión?</h3>
                <p class="text-xs text-gray-400 leading-relaxed">Agenda una cita en nuestras oficinas y platiquemos en persona.</p>
              </div>
            </div>
            <a href={contact.whatsapp} target="_blank" rel="noopener" class="btn-primary !py-3 !px-5 !text-[11px] relative">
              Agendar cita
              <Icon name="arrow" size={14} stroke={2} />
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Closing band -->
  <section class="bg-surface pb-16 lg:pb-20">
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10">
      <div class="hero reveal">
        <div class="hero-media dim" style="background-image:url('/img/cta-band.jpg')"></div>
        <div class="relative px-8 py-10 flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-12">
          <Icon name="home" size={40} class="text-gold shrink-0" stroke={1.2} />
          <div class="text-center lg:text-left">
            <h2 class="display display-sm text-white mb-2">Vamos a construir algo grande</h2>
            <p class="text-sm text-gray-400">Juntos podemos hacer realidad el proyecto que tienes en mente.</p>
          </div>
          <a href={contact.whatsapp} target="_blank" rel="noopener" class="btn-primary shrink-0">
            Cotiza tu proyecto
            <Icon name="arrow" size={16} stroke={2} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" variant="compact" legal={true} />
</Layout>
