---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto - AHH Construcción y Remodelación" activePage="CONTACTO">
  <Header slot="header" activePage="CONTACTO" />

  <!-- Hero -->
  <section class="relative bg-navy-dark pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm mb-8">
            <a href="/" class="text-gold hover:text-gold-light transition-colors">Inicio</a>
            <span class="text-gold">&gt;</span>
            <span class="text-gold">Contacto</span>
          </nav>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" style="font-family: var(--font-heading);">
            ESTAMOS LISTOS PARA CONSTRUIR
            <span class="italic text-gold">TU PROYECTO.</span>
          </h1>

          <div class="gold-line mt-6 mb-6"></div>

          <p class="text-gray-400 text-lg max-w-lg">
            Hablemos de tus ideas y encontremos la mejor solución para hacerlas realidad.
          </p>
        </div>

        <!-- Right placeholder -->
        <div class="hidden lg:block h-80 rounded-lg" style="background: linear-gradient(135deg, rgba(26,29,46,0.9), rgba(15,17,25,0.95));"></div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">

        <!-- Column 1 - Form -->
        <div class="border border-gray-200 rounded-lg shadow-lg p-8">
          <div class="flex items-center gap-3 mb-6">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <h2 class="text-xl font-bold text-navy-dark tracking-wide">ENVÍANOS UN MENSAJE</h2>
          </div>

          <form class="space-y-5">
            <!-- Row 1: Nombre + Teléfono -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nombre completo*</label>
                <input type="text" placeholder="Tu nombre" required class="border border-gray-300 rounded px-4 py-3 w-full focus:outline-none focus:border-gold transition-colors" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Teléfono*</label>
                <input type="tel" placeholder="(000) 000 0000" required class="border border-gray-300 rounded px-4 py-3 w-full focus:outline-none focus:border-gold transition-colors" />
              </div>
            </div>

            <!-- Row 2: Correo + Tipo de proyecto -->
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Correo electrónico*</label>
                <input type="email" placeholder="tu@correo.com" required class="border border-gray-300 rounded px-4 py-3 w-full focus:outline-none focus:border-gold transition-colors" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de proyecto</label>
                <select class="border border-gray-300 rounded px-4 py-3 w-full focus:outline-none focus:border-gold transition-colors bg-white text-gray-700">
                  <option value="">Seleccionar...</option>
                  <option value="construccion">Construcción</option>
                  <option value="remodelacion">Remodelación</option>
                  <option value="desarrollo">Desarrollo inmobiliario</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
            </div>

            <!-- Textarea -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Cuéntanos sobre tu proyecto*</label>
              <textarea rows="5" placeholder="Describe brevemente lo que tienes en mente..." required class="border border-gray-300 rounded px-4 py-3 w-full focus:outline-none focus:border-gold transition-colors resize-none"></textarea>
            </div>

            <!-- Submit -->
            <button type="button" class="btn-gold w-full justify-center tracking-widest">
              ENVIAR MENSAJE
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>

          <!-- Privacy note -->
          <div class="flex items-center gap-2 mt-4 text-xs text-gray-500">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-green-500 flex-shrink-0">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <span>Tu información está protegida. No compartimos tus datos.</span>
          </div>
        </div>

        <!-- Column 2 - Contact Info -->
        <div class="flex flex-col items-center text-center space-y-10 py-8">

          <!-- Teléfono -->
          <div>
            <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center mx-auto mb-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <h3 class="text-sm font-bold tracking-wider text-navy-dark mb-1">TELÉFONO</h3>
            <p class="text-gray-800 font-medium">(614) 123 4567</p>
            <p class="text-gray-500 text-sm">Lunes a Viernes de 9:00 a 18:00 hrs</p>
          </div>

          <!-- Correo -->
          <div>
            <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center mx-auto mb-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <h3 class="text-sm font-bold tracking-wider text-navy-dark mb-1">CORREO</h3>
            <p class="text-gray-800 font-medium">contacto@ahhconstruccion.mx</p>
            <p class="text-gray-500 text-sm">Responderemos a la brevedad</p>
          </div>

          <!-- Dirección -->
          <div>
            <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center mx-auto mb-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <h3 class="text-sm font-bold tracking-wider text-navy-dark mb-1">DIRECCIÓN</h3>
            <p class="text-gray-800 font-medium">Chihuahua, Chihuahua, México</p>
            <p class="text-gray-500 text-sm">C.P. 31200</p>
          </div>

          <!-- Síguenos -->
          <div>
            <div class="w-12 h-12 rounded-full bg-gold/10 flex items-center justify-center mx-auto mb-3">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
              </svg>
            </div>
            <h3 class="text-sm font-bold tracking-wider text-navy-dark mb-1">SÍGUENOS</h3>
            <div class="flex items-center justify-center gap-3 mt-3">
              <!-- Facebook -->
              <a href="#" class="w-10 h-10 rounded-full bg-gold flex items-center justify-center text-white hover:bg-gold-dark transition-colors" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
              <!-- Instagram -->
              <a href="#" class="w-10 h-10 rounded-full bg-gold flex items-center justify-center text-white hover:bg-gold-dark transition-colors" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <!-- LinkedIn -->
              <a href="#" class="w-10 h-10 rounded-full bg-gold flex items-center justify-center text-white hover:bg-gold-dark transition-colors" aria-label="LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Column 3 - Map + CTA -->
        <div class="space-y-6">
          <!-- Map -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gold">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <h2 class="text-xl font-bold text-navy-dark tracking-wide">NUESTRA UBICACIÓN</h2>
            </div>
            <div class="h-64 bg-gray-200 rounded-lg border border-gray-300 flex items-center justify-center">
              <span class="text-gray-500 text-lg font-medium">Mapa</span>
            </div>
          </div>

          <!-- CTA Card -->
          <div class="relative bg-navy-dark rounded-lg p-8 overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold"></div>
            <h3 class="text-xl font-bold text-white tracking-wide mb-3">¿PREFIERES UNA REUNIÓN?</h3>
            <p class="text-gray-400 text-sm mb-6">
              Agenda una cita en nuestras oficinas y platiquemos en persona.
            </p>
            <a href="#" class="btn-gold text-xs tracking-widest">
              AGENDAR CITA
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
