---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { projects, brand } from '../data/site';

const heroFacts = [
  { value: `+${brand.yearsOfExperience}`, label: 'Años de<br>experiencia', icon: 'clock' },
  { value: '', label: 'Residencial<br>y comercial', icon: 'buildings' },
  { value: '', label: 'Garantía<br>según proyecto', icon: 'badge' },
];

const delays = ['', 'reveal-delay-1', 'reveal-delay-2'];
---

<Layout title="Proyectos — AHH Construcción y Remodelación">
  <Header slot="header" activePage="Proyectos" />

  <!-- Hero -->
  <section data-nav-theme="dark" class="hero">
    <div class="hero-media" style="background-image:url('/img/hero-proyectos.jpg')"></div>
    <div class="relative max-w-[88rem] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-12">

        <div class="max-w-lg">
          <nav class="reveal flex items-center gap-2 text-sm mb-5">
            <a href="/" class="text-white/70 hover:text-white transition-colors">Inicio</a>
            <span class="text-white/30">&rsaquo;</span>
            <span class="text-sand">Proyectos</span>
          </nav>

          <h1 class="reveal reveal-delay-1 display display-lg text-white mb-6">Proyectos realizados</h1>

          <p class="reveal reveal-delay-2 text-gray-300 leading-relaxed">
            Obra residencial y comercial en Chihuahua. Estas son las casas que mejor
            representan cómo trabajamos.
          </p>
        </div>

        <div class="reveal reveal-delay-3 grid grid-cols-3 gap-8 lg:gap-0 lg:divide-x divide-white/15">
          {heroFacts.map(s => (
            <div class="text-center lg:px-8">
              <Icon name={s.icon} size={34} class="text-sand mx-auto mb-3" stroke={1.2} />
              {s.value && <p class="display text-2xl text-white leading-none mb-2" data-count={s.value}>{s.value}</p>}
              <p class="text-[11px] text-gray-300 tracking-[0.12em] uppercase leading-relaxed" set:html={s.label} />
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="bg-bone py-14 lg:py-16">
    <div class="max-w-[88rem] mx-auto px-6 lg:px-10">

      <div class="reveal mb-12">
        <p class="eyebrow mb-4">Obra entregada</p>
        <h2 class="heading">Residencial Los Leones</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((p, i) => (
          <article class={`card reveal-scale ${delays[i]}`} data-category={p.category}>
            <div class="media h-60" style={p.image ? `background-image:url('${p.image}')` : undefined}>
              <span class="tag">{p.categoryLabel}</span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-semibold mb-3">{p.name}</h3>
              <div class="flex items-center justify-between gap-4">
                <p class="flex items-center gap-2 text-sm text-gray-500">
                  <Icon name="pin" size={16} class="text-accent-deep shrink-0" />
                  {p.location}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA band -->
      <div class="reveal bg-dark noise mt-12 px-8 py-8 flex flex-col lg:flex-row items-center gap-6">
        <div class="w-14 h-14 border border-accent/40 flex items-center justify-center shrink-0">
          <Icon name="calendar" size={26} class="text-sand" stroke={1.3} />
        </div>
        <div class="flex-1 text-center lg:text-left">
          <h3 class="display display-sm text-white mb-1">¿Tienes un proyecto en mente?</h3>
          <p class="text-sm text-gray-400">Agendamos una visita y te cotizamos en sitio.</p>
        </div>
        <a href="/contacto" class="btn-primary shrink-0">
          Cotiza tu proyecto
          <Icon name="arrow" size={16} stroke={2} />
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" variant="compact" />
</Layout>
